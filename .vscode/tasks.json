{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pre-Build Check",
      "type": "shell",
      "command": "npm run pre-build",
      "problemMatcher": ["$tsc", "$eslint-stylish"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Type Check",
      "type": "shell",
      "command": "npm run type-check",
      "problemMatcher": ["$tsc"],
      "group": "test"
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": ["$eslint-stylish"],
      "group": "test"
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": ["$tsc"],
      "group": "build"
    }
  ]
}
